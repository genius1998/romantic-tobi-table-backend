# ── Spring Boot 서버 주소 ──────────────────────────────
SPRING_BASE_URL=http://localhost:8080

# ── LLM Provider (local | anthropic | openai) ─────────
# 기본값: local (외부 API 키 없이 로컬 LLM 서버 사용)
LLM_PROVIDER=local

# ── 로컬 LLM 설정 (LLM_PROVIDER=local 시 사용) ────────
LOCAL_LLM_URL=http://169.213.5.157:3000/api/chat
LOCAL_LLM_MODEL=gpt-oss:20b
LOCAL_LLM_TIMEOUT=120
LOCAL_LLM_REFERER=http://169.213.5.157:3000/
LOCAL_LLM_USER_AGENT=Mozilla/5.0

# ── 선택: Anthropic Claude (LLM_PROVIDER=anthropic 시) ─
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── 선택: OpenAI (LLM_PROVIDER=openai 시) ─────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── 임베딩 모델 (로컬) ────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── RAG 설정 ──────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
