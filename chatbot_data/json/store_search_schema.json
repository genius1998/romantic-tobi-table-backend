{
  "description": "토미도우미 챗봇이 가게 검색 API를 호출할 때 사용하는 스키마",
  "store_entity_fields": {
    "id": "Long - PK",
    "name": "String - 가게명 (필수)",
    "address": "String - 도로명 주소 (필수)",
    "jibun_address": "String - 지번 주소",
    "district": "String - 동/구 이름",
    "primary_category": "String - 대분류 업종",
    "secondary_category": "String - 소분류 업종",
    "phone": "String - 전화번호",
    "coord_x": "Double - 경도",
    "coord_y": "Double - 위도",
    "area": "BigDecimal - 면적",
    "licensed_at": "LocalDate - 인허가일"
  },
  "missing_fields_for_chatbot": [
    {
      "field": "aliases",
      "type": "String (JSON array 또는 comma-separated)",
      "description": "가게 별칭/동의어 목록. OCR 인식명과 DB명 차이 처리에 활용",
      "example": "[\"메가엠지씨커피\", \"MEGACOFFEE\"]"
    },
    {
      "field": "normalized_name",
      "type": "String",
      "description": "정규화된 가게명. 챗봇 검색 및 유사도 계산 최적화",
      "example": "메가커피"
    },
    {
      "field": "reward_eligible",
      "type": "Boolean",
      "description": "포인트 적립 가능 여부 (일부 가게 제외 처리용)",
      "default": true
    }
  ],
  "chatbot_search_api_draft": {
    "endpoint": "GET /api/stores/search",
    "params": {
      "keyword": "가게명 검색어 (optional)",
      "category": "업종 필터 (optional, primary_category 기준)",
      "district": "동 필터 (optional)",
      "page": "페이지 번호 (default: 0)",
      "size": "페이지 크기 (default: 10)"
    },
    "response": "StoreSearchResponse[]"
  },
  "category_examples": {
    "note": "V3~V12 migration SQL에서 실제 category 값 확인 필요",
    "known_primary_categories": [
      "한식",
      "중식",
      "일식",
      "양식",
      "카페/음료",
      "분식",
      "치킨/피자",
      "생활서비스"
    ]
  }
}
